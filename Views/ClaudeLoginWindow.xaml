<Window x:Class="ClaudeUsageMonitor.Views.ClaudeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClaudeUsageMonitor.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding [login_title], Source={x:Static svc:LocalizationService.Instance}}"
        Width="960" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Border Background="#1c1c1c"
            CornerRadius="12"
            BorderBrush="#2e2e2e"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="6" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="*"/>      <!-- webview -->
                <RowDefinition Height="Auto"/>   <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="16,12,12,12"
                    BorderBrush="#252525" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDrag" CornerRadius="12,12,0,0"
                    Background="#161616">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✳" Foreground="#ff8c55" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding [login_title], Source={x:Static svc:LocalizationService.Instance}}"
                                   Foreground="#f0f0f0" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="{Binding [login_subtitle], Source={x:Static svc:LocalizationService.Instance}}"
                                   Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕" Width="28" Height="28"
                            Foreground="#555555" FontSize="13" Cursor="Hand"
                            Click="OnCancel">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2a2a2a"/>
                                                    <Setter Property="Foreground" Value="#aaaaaa"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- WebView2 -->
            <Border Grid.Row="1" Background="#ffffff">
                <Grid>
                    <!-- Loading placeholder shown while WebView initialises -->
                    <TextBlock x:Name="LoadingText"
                               Text="{Binding [login_loading], Source={x:Static svc:LocalizationService.Instance}}"
                               Foreground="#888888" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="16,8" Background="#161616"
                    BorderBrush="#252525" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid>
                    <TextBlock x:Name="StatusText"
                               Text="{Binding [login_waiting], Source={x:Static svc:LocalizationService.Instance}}"
                               Foreground="#555555" FontSize="11" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Content="{Binding [btn_cancel], Source={x:Static svc:LocalizationService.Instance}}"
                            Foreground="#666666" FontSize="11" Cursor="Hand"
                            Padding="14,5" Click="OnCancel">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2a2a2a"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#383838"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
