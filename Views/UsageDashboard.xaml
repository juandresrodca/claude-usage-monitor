<Window x:Class="ClaudeUsageMonitor.Views.UsageDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClaudeUsageMonitor.Services"
        Title="Claude Usage Monitor"
        Width="440" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <!-- DataContext is set in code-behind (needs TrayService reference) -->

    <Window.Resources>

        <!-- Rounded progress bar -->
        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#2e2e2e"/>
            <Setter Property="Foreground" Value="#4a90e2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="6">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track" Background="Transparent" CornerRadius="3">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable percent label -->
        <Style x:Key="PercentLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section heading -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Margin" Value="0,14,0,14"/>
        </Style>

        <Style x:Key="InlineEdit" TargetType="TextBox">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4a90e2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- Icon button shared style -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2a2a2a"/>
                                <Setter Property="Foreground" Value="#aaaaaa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#1c1c1c"
            CornerRadius="14"
            BorderBrush="#2e2e2e"
            BorderThickness="1"
            MouseLeftButtonDown="OnDragMove">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- header -->
                <RowDefinition Height="Auto"/>  <!-- connection strip -->
                <RowDefinition Height="*"/>     <!-- content -->
                <RowDefinition Height="Auto"/>  <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Padding="20,14,14,14" CornerRadius="14,14,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✳" Foreground="#ff8c55" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding [dashboard_title], Source={x:Static svc:LocalizationService.Instance}}"
                                   Foreground="#f0f0f0" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Background="#2d2010" CornerRadius="10" Padding="10,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding PlanTier}" Foreground="#ff9a5c"
                                       FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <!-- Sync button -->
                        <Button x:Name="SyncBtn" Width="28" Height="28" Padding="0"
                                Style="{StaticResource IconBtn}" Click="OnSync"
                                ToolTip="{Binding [tip_sync], Source={x:Static svc:LocalizationService.Instance}}">
                            <TextBlock Text="{Binding SyncButtonText}" FontSize="14"/>
                        </Button>
                        <!-- Settings button -->
                        <Button Width="28" Height="28" Padding="0" Margin="2,0,0,0"
                                Style="{StaticResource IconBtn}" Click="OnOpenSettings"
                                ToolTip="{Binding [tip_settings], Source={x:Static svc:LocalizationService.Instance}}">
                            <TextBlock Text="⚙" FontSize="13"/>
                        </Button>
                        <!-- Close -->
                        <Button Width="28" Height="28" Padding="0" Margin="2,0,0,0"
                                Style="{StaticResource IconBtn}" Click="OnClose"
                                ToolTip="{Binding [tip_close], Source={x:Static svc:LocalizationService.Instance}}">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ CONNECTION STRIP ═════════════════════════════════════════ -->
            <Border Grid.Row="1" Padding="18,8" Background="#181818"
                    BorderBrush="#252525" BorderThickness="0,1,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status dot (colour set in code-behind via IsConnected) -->
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7"
                                 Margin="0,0,7,0" VerticalAlignment="Center" Fill="#555555"/>
                        <TextBlock Text="{Binding ConnectionText}"
                                   Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                                <!-- Sync error/status message (visibility toggled in code-behind via SyncStatus) -->
                    <TextBlock x:Name="SyncStatusText"
                               Text="{Binding SyncStatus}" HorizontalAlignment="Right"
                               Foreground="#cc6666" FontSize="11" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- ══ CONTENT ══════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2" Padding="20,14,20,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ── Sesión actual ──────────────────────────────── -->
                    <TextBlock Text="{Binding [section_current_session], Source={x:Static svc:LocalizationService.Instance}}"
                               Style="{StaticResource SectionHeading}"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Style="{StaticResource UsageBar}"
                                     Value="{Binding SessionPercent}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="SessionPctLabel"
                                       Text="{Binding SessionPercentText}"
                                       Style="{StaticResource PercentLabel}"
                                       MouseLeftButtonDown="SessionPct_Edit"/>
                            <TextBox x:Name="SessionPctEdit" Style="{StaticResource InlineEdit}"
                                     Visibility="Collapsed"
                                     KeyDown="SessionPctEdit_KeyDown"
                                     LostFocus="SessionPctEdit_LostFocus"/>
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding SessionResetText}" Style="{StaticResource MutedText}"
                               Margin="0,0,0,4"/>

                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Límites semanales ──────────────────────────── -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding [section_weekly_limits], Source={x:Static svc:LocalizationService.Instance}}"
                                   Style="{StaticResource SectionHeading}"
                                   VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://claude.ai/settings/limits"
                                       RequestNavigate="Hyperlink_Navigate"
                                       Foreground="#4a90e2">
                                <Run Text="{Binding [more_info], Source={x:Static svc:LocalizationService.Instance}, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <!-- Todos los modelos -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{Binding [row_all_models], Source={x:Static svc:LocalizationService.Instance}}"
                                   Style="{StaticResource RowLabel}"/>
                        <Grid HorizontalAlignment="Right">
                            <TextBlock x:Name="AllModelsPctLabel"
                                       Text="{Binding AllModelsPercentText}"
                                       Style="{StaticResource PercentLabel}"
                                       MouseLeftButtonDown="AllModelsPct_Edit"/>
                            <TextBox x:Name="AllModelsPctEdit" Style="{StaticResource InlineEdit}"
                                     Visibility="Collapsed"
                                     KeyDown="AllModelsPctEdit_KeyDown"
                                     LostFocus="AllModelsPctEdit_LostFocus"/>
                        </Grid>
                    </Grid>
                    <ProgressBar Style="{StaticResource UsageBar}"
                                 Value="{Binding AllModelsPercent}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding WeeklyAllModelsResetText}"
                               Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

                    <!-- Opus weekly -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{Binding [row_opus], Source={x:Static svc:LocalizationService.Instance}}"
                                   Style="{StaticResource RowLabel}"/>
                        <Grid HorizontalAlignment="Right">
                            <TextBlock x:Name="DesignPctLabel"
                                       Text="{Binding ClaudeDesignPercentText}"
                                       Style="{StaticResource PercentLabel}"
                                       MouseLeftButtonDown="DesignPct_Edit"/>
                            <TextBox x:Name="DesignPctEdit" Style="{StaticResource InlineEdit}"
                                     Visibility="Collapsed"
                                     KeyDown="DesignPctEdit_KeyDown"
                                     LostFocus="DesignPctEdit_LostFocus"/>
                        </Grid>
                    </Grid>
                    <ProgressBar Style="{StaticResource UsageBar}"
                                 Value="{Binding ClaudeDesignPercent}"
                                 Foreground="#7c6cd4" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ClaudeDesignSubText}"
                               Style="{StaticResource MutedText}" Margin="0,0,0,4"/>

                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Funciones adicionales ──────────────────────── -->
                    <TextBlock Text="{Binding [section_additional_features], Source={x:Static svc:LocalizationService.Instance}}"
                               Style="{StaticResource SectionHeading}"/>
                    <Border Background="#202020" CornerRadius="8" Padding="14,12">
                        <TextBlock Text="{Binding [no_additional_features], Source={x:Static svc:LocalizationService.Instance}}"
                                   Foreground="#383838" FontSize="12" FontStyle="Italic"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Height="14"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ FOOTER ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#1c1c1c" CornerRadius="0,0,14,14"
                    BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="20,10,14,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [last_updated], Source={x:Static svc:LocalizationService.Instance}}"
                                   Foreground="#383838" FontSize="11"/>
                        <TextBlock Text="{Binding LastRefreshText}" Foreground="#484848" FontSize="11"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                            Style="{StaticResource IconBtn}" Click="OnRefresh"
                            ToolTip="{Binding [tip_refresh], Source={x:Static svc:LocalizationService.Instance}}">
                        <TextBlock Text="↻" FontSize="15"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
