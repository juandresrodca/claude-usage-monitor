<Window x:Class="ClaudeUsageMonitor.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClaudeUsageMonitor.Services"
        Title="{Binding [settings_title], Source={x:Static svc:LocalizationService.Instance}}"
        Width="480" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#4a90e2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#ff8c55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ff7040"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#2e2e2e"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3a3a3a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#1c1c1c"
            CornerRadius="14"
            BorderBrush="#2e2e2e"
            BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="20,16,16,16" BorderBrush="#252525" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" Foreground="#888888" FontSize="15" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding [settings_title], Source={x:Static svc:LocalizationService.Instance}}"
                                   Foreground="#f0f0f0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕" Width="28" Height="28"
                            Foreground="#555555" FontSize="13" Cursor="Hand" Click="OnClose"
                            Style="{StaticResource SecondaryBtn}" Padding="0"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Padding="20,16,20,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Account section header -->
                    <TextBlock Text="{Binding [section_claude_account], Source={x:Static svc:LocalizationService.Instance}}"
                               Foreground="#555555" FontSize="10"
                               FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Primary: browser login -->
                    <Border Background="#1a2a1a" CornerRadius="10" Padding="16,14" Margin="0,0,0,6"
                            BorderBrush="#2a3a2a" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding [browser_login_title], Source={x:Static svc:LocalizationService.Instance}}"
                                       Foreground="#88cc88" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding [browser_login_desc], Source={x:Static svc:LocalizationService.Instance}}"
                                       Foreground="#6a886a" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LoginBtn"
                                        Content="{Binding [btn_login_with_claude], Source={x:Static svc:LocalizationService.Instance}}"
                                        Style="{StaticResource PrimaryBtn}"
                                        Click="OnLoginWithBrowser"/>
                                <Button x:Name="ClearBtn"
                                        Content="{Binding [btn_clear_session], Source={x:Static svc:LocalizationService.Instance}}"
                                        Style="{StaticResource SecondaryBtn}"
                                        Margin="8,0,0,0"
                                        ToolTip="{Binding [tip_clear_session], Source={x:Static svc:LocalizationService.Instance}}"
                                        Click="OnClearSession"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status line (shared by both methods) -->
                    <Border x:Name="StatusBorder" CornerRadius="6" Padding="10,7" Margin="0,6,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Diagnostics: discover the real usage endpoint by sniffing claude.ai -->
                    <Border Background="#1c1c2a" CornerRadius="10" Padding="14,12" Margin="0,12,0,0"
                            BorderBrush="#2a2a3a" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding [section_diagnostics], Source={x:Static svc:LocalizationService.Instance}}"
                                       Foreground="#8a99cc" FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [diagnostics_desc], Source={x:Static svc:LocalizationService.Instance}}"
                                       Foreground="#6a7088" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Button x:Name="DiscoverBtn"
                                    Content="{Binding [btn_discover_endpoint], Source={x:Static svc:LocalizationService.Instance}}"
                                    Style="{StaticResource SecondaryBtn}"
                                    HorizontalAlignment="Left"
                                    Click="OnDiscoverEndpoints"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#252525" Margin="0,16,0,14"/>

                    <!-- Fallback: manual session key -->
                    <TextBlock Text="{Binding [section_manual_key], Source={x:Static svc:LocalizationService.Instance}}"
                               Foreground="#444444"
                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding [label_session_key], Source={x:Static svc:LocalizationService.Instance}}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="SessionKeyBox"
                                     Grid.Column="0"
                                     Background="#252525"
                                     Foreground="White"
                                     BorderBrush="#333333"
                                     BorderThickness="1"
                                     Padding="10,7"
                                     FontSize="12"
                                     CaretBrush="White"
                                     SelectionBrush="#4a90e2"
                                     FontFamily="Consolas"
                                     PasswordChanged="SessionKeyBox_Changed"/>
                        <Button Grid.Column="1"
                                Content="{Binding [btn_test], Source={x:Static svc:LocalizationService.Instance}}"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryBtn}"
                                Click="OnTestConnection" x:Name="TestBtn"/>
                    </Grid>

                    <Border Height="1" Background="#252525" Margin="0,16,0,14"/>

                    <!-- Auto-refresh -->
                    <TextBlock Text="{Binding [section_auto_refresh], Source={x:Static svc:LocalizationService.Instance}}"
                               Foreground="#555555" FontSize="10"
                               FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [label_refresh_every], Source={x:Static svc:LocalizationService.Instance}}"
                                   Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <TextBox x:Name="RefreshMinBox" Style="{StaticResource InputBox}"
                                 Width="52" Text="10" TextAlignment="Center"/>
                        <TextBlock Text="{Binding [label_minutes], Source={x:Static svc:LocalizationService.Instance}}"
                                   Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <Border Height="1" Background="#252525" Margin="0,16,0,14"/>

                    <!-- Language -->
                    <TextBlock Text="{Binding [section_language], Source={x:Static svc:LocalizationService.Instance}}"
                               Foreground="#555555" FontSize="10"
                               FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangEsRadio" GroupName="Lang"
                                     Content="{Binding [lang_spanish], Source={x:Static svc:LocalizationService.Instance}}"
                                     Foreground="#cccccc" Margin="0,0,16,0"
                                     Checked="OnLanguageChanged" Tag="Es"/>
                        <RadioButton x:Name="LangEnRadio" GroupName="Lang"
                                     Content="{Binding [lang_english], Source={x:Static svc:LocalizationService.Instance}}"
                                     Foreground="#cccccc"
                                     Checked="OnLanguageChanged" Tag="En"/>
                    </StackPanel>

                    <Border Height="16"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="20,12" BorderBrush="#252525" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [btn_cancel], Source={x:Static svc:LocalizationService.Instance}}"
                            Style="{StaticResource SecondaryBtn}"
                            Margin="0,0,8,0" Click="OnClose"/>
                    <Button x:Name="SaveBtn"
                            Content="{Binding [btn_save], Source={x:Static svc:LocalizationService.Instance}}"
                            Style="{StaticResource PrimaryBtn}"
                            Click="OnSave"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
